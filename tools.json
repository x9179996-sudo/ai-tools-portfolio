      "id": "demo1",
      "title": "數學一百格大挑戰",
      "desc": "加減乘除四種模式的一百格計算訓練，支援計時與進度追蹤，適合全年級學生練習基礎運算。",
      "subjects": [
        "數學"
      ],
      "grades": [
        "低年級",
        "中年級",
        "高年級"
      ],
      "funcs": [
        "遊戲",
        "測驗"
      ],
      "url": "",
      "code": "<!DOCTYPE html><html lang=\"zh-TW\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>數學一百格</title><script src=\"https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js\"></script><script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script><script crossorigin src=\"https://cdnjs.cloudflare.com/ajax/libs/react/18.3.1/umd/react.production.min.js\"></script><script crossorigin src=\"https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.3.1/umd/react-dom.production.min.js\"></script></head><body><div id=\"root\"></div><script type=\"text/babel\">const {useState,useEffect,useRef}=React;\nconst MODES={add:{name:\"加法\",sign:\"+\",c:\"bg-pink-100\",t:\"text-pink-600\",b:\"border-pink-300\"},sub:{name:\"減法\",sign:\"-\",c:\"bg-blue-100\",t:\"text-blue-600\",b:\"border-blue-300\"},mul:{name:\"乘法\",sign:\"×\",c:\"bg-green-100\",t:\"text-green-600\",b:\"border-green-300\"},div:{name:\"除法\",sign:\"÷\",c:\"bg-purple-100\",t:\"text-purple-600\",b:\"border-purple-300\"}};\nconst sh=a=>a.sort(()=>Math.random()-.5);\nconst fmt=ms=>{const t=Math.floor(ms/1000),m=Math.floor(t/60),s=t%60,c=Math.floor((ms%1000)/10);return String(m).padStart(2,\"0\")+\":\"+String(s).padStart(2,\"0\")+\".\"+String(c).padStart(2,\"0\");};\nconst gen=mode=>{if(mode===\"div\"){const cells=[];for(let i=0;i<100;i++){let d=Math.floor(Math.random()*9)+1,q=Math.floor(Math.random()*9)+1,n=d*q;while(n<10||n>99){d=Math.floor(Math.random()*9)+1;q=Math.floor(Math.random()*9)+1;n=d*q;}cells.push({id:i,qText:n+\"÷\"+d,answer:q,userInput:\"\",status:\"empty\"});}return{type:\"flat\",cells};}let cols,rows;if(mode===\"add\"||mode===\"mul\"){cols=sh([...Array(10).keys()]);rows=sh([...Array(10).keys()]);}else{cols=sh(Array.from({length:10},(_,i)=>i+10));rows=sh([...Array(10).keys()]);}const cells=[];for(let r=0;r<10;r++)for(let c=0;c<10;c++){const cv=cols[c],rv=rows[r];let a=0;if(mode===\"add\")a=cv+rv;if(mode===\"sub\")a=cv-rv;if(mode===\"mul\")a=cv*rv;cells.push({id:r*10+c,answer:a,qText:cv+MODES[mode].sign+rv,userInput:\"\",status:\"empty\"});}return{type:\"grid\",cols,rows,cells};};\nfunction App(){const[sc,setSc]=useState(\"home\");const[mode,setMode]=useState(null);const[gd,setGd]=useState(null);const[play,setPlay]=useState(false);const[ms,setMs]=useState(0);const tRef=useRef(null);const sRef=useRef(0);const iRefs=useRef([]);\nuseEffect(()=>{if(play){sRef.current=Date.now()-ms;tRef.current=setInterval(()=>setMs(Date.now()-sRef.current),50);}else clearInterval(tRef.current);return()=>clearInterval(tRef.current);},[play]);\nconst start=m=>{setMode(m);setGd(gen(m));setMs(0);setPlay(true);setSc(\"game\");iRefs.current=[];};\nconst stop=()=>{setPlay(false);setSc(\"home\");};\nconst inp=(idx,val)=>{if(!play)return;if(val!==\"\"&&!/^\\d+$/.test(val))return;const nc=[...gd.cells];const cell=nc[idx];cell.userInput=val;if(val===\"\"){cell.status=\"empty\";}else{const as=String(cell.answer);if(val.length>=as.length){if(parseInt(val)===cell.answer){cell.status=\"correct\";if(idx<99)setTimeout(()=>iRefs.current[idx+1]?.focus(),100);}else{cell.status=\"wrong\";setTimeout(()=>{const cur=[...gd.cells];if(cur[idx].status===\"wrong\"){cur[idx].userInput=\"\";cur[idx].status=\"empty\";setGd({...gd,cells:cur});}},600);}}}setGd({...gd,cells:nc});if(nc.every(c=>c.status===\"correct\"))setPlay(false);};\nconst key=(e,idx)=>{if(e.key===\"Enter\"||e.key===\"Tab\"){e.preventDefault();iRefs.current[idx+1]?.focus();}};\nconst mc=mode?MODES[mode]:null;const ok=gd?gd.cells.filter(c=>c.status===\"correct\").length:0;\nif(sc===\"home\")return(<div className=\"min-h-screen bg-orange-50 flex flex-col items-center justify-center p-4\"><div className=\"max-w-2xl w-full bg-white rounded-3xl shadow-xl p-8 text-center\"><h1 className=\"text-4xl font-extrabold text-orange-600 mb-2\">數學一百格大挑戰</h1><p className=\"text-gray-600 text-lg mb-8\">選一個模式開始</p><div className=\"grid grid-cols-2 gap-4\">{Object.entries(MODES).map(([k,m])=>(<button key={k} onClick={()=>start(k)} className={m.c+\" \"+m.b+\" border-4 rounded-2xl p-6 flex flex-col items-center hover:scale-105 transition\"}><span className={\"text-5xl font-black \"+m.t+\" mb-2\"}>{m.sign}</span><span className={\"text-2xl font-bold \"+m.t}>{m.name}</span></button>))}</div></div></div>);\nif(sc===\"game\"&&gd)return(<div className=\"min-h-screen bg-gray-50 flex flex-col pt-4 px-2 pb-10\"><div className=\"max-w-5xl mx-auto w-full\"><div className=\"bg-white rounded-2xl shadow-sm p-4 mb-4 flex flex-wrap justify-between items-center gap-4 border-2 border-gray-100\"><div className=\"flex items-center gap-3\"><span className={\"px-4 py-2 rounded-xl text-xl font-bold \"+mc.c+\" \"+mc.t}>{mc.name}</span><div className=\"bg-gray-100 px-4 py-2 rounded-xl text-2xl font-mono font-bold text-gray-700\">{fmt(ms)}</div></div><div className=\"flex-1 max-w-xs\"><div className=\"bg-gray-200 rounded-full h-4 overflow-hidden relative\"><div className=\"bg-green-400 h-4 transition-all\" style={{width:ok+\"%\"}}></div><div className=\"absolute inset-0 flex justify-center items-center text-[10px] font-bold text-gray-600\">{ok}/100</div></div></div><button onClick={stop} className=\"bg-red-100 text-red-600 px-4 py-2 rounded-xl font-bold hover:bg-red-200\">結束</button></div><div className=\"bg-white rounded-3xl shadow-lg p-2 sm:p-4 overflow-x-auto border-4 border-gray-100\">{gd.type===\"grid\"?(<div className=\"min-w-max grid grid-cols-11 gap-1\"><div className={\"flex justify-center items-center rounded-xl text-3xl font-black \"+mc.c+\" \"+mc.t}>{mc.sign}</div>{gd.cols.map((c,i)=><div key={i} className={\"w-10 h-10 sm:w-12 sm:h-12 flex justify-center items-center rounded-xl text-lg font-bold \"+mc.c+\" \"+mc.t}>{c}</div>)}{gd.rows.map((row,r)=>(<React.Fragment key={r}><div className={\"w-10 h-10 sm:w-12 sm:h-12 flex justify-center items-center rounded-xl text-lg font-bold \"+mc.c+\" \"+mc.t}>{row}</div>{gd.cells.slice(r*10,r*10+10).map(cell=>(<input key={cell.id} ref={el=>iRefs.current[cell.id]=el} type=\"text\" inputMode=\"numeric\" maxLength={3} disabled={!play} value={cell.userInput} onChange={e=>inp(cell.id,e.target.value)} onKeyDown={e=>key(e,cell.id)} className={\"w-10 h-10 sm:w-12 sm:h-12 text-center text-lg font-bold rounded-xl outline-none transition \"+(cell.status===\"correct\"?\"bg-green-200 text-green-800 border-2 border-green-400\":cell.status===\"wrong\"?\"bg-orange-100 border-2 border-orange-300\":\"bg-gray-50 border-2 border-gray-200 focus:bg-yellow-50 focus:border-yellow-400\")}/>))}</React.Fragment>))}</div>):(<div className=\"min-w-max grid grid-cols-10 gap-2\">{gd.cells.map(cell=>(<div key={cell.id} className={\"flex flex-col items-center p-1 rounded-2xl border-2 \"+(cell.status===\"correct\"?\"bg-green-50 border-green-300\":\"bg-gray-50 border-gray-200\")}><div className=\"text-xs font-bold text-gray-500 mb-1\">{cell.qText}</div><input ref={el=>iRefs.current[cell.id]=el} type=\"text\" inputMode=\"numeric\" maxLength={2} disabled={!play} value={cell.userInput} onChange={e=>inp(cell.id,e.target.value)} onKeyDown={e=>key(e,cell.id)} className={\"w-8 h-8 sm:w-10 sm:h-10 text-center text-lg font-bold rounded-lg outline-none \"+(cell.status===\"correct\"?\"bg-green-200 text-green-800\":cell.status===\"wrong\"?\"bg-orange-100\":\"bg-white\")}/></div>))}</div>)}</div></div></div>);\nreturn null;}\nReactDOM.createRoot(document.getElementById(\"root\")).render(<App/>);</script></body></html>",
      "thumb": "",
